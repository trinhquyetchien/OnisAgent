# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_DB=onisagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=
DYNAMODB_TABLE_NAME=
USER_ID=demo
DATA_SOURCE=csv
SAMPLE_DATA_PATH=data/sample_transactions_onis.csv

# Reasoning Path (Local Ollama LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
REASONING_PROVIDER=ollama

# Authentication
# Keep false for backwards-compatible local demo requests; use true in production.
AUTH_REQUIRED=false
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=86400
LOCAL_STORAGE_PATH=data/local/onis_state.json

# PostgreSQL Authentication
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/onisagent
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_JWT_ISSUER=onisagent
GOOGLE_WEB_CLIENT_ID=

# SMTP OTP delivery (use SMTP_STARTTLS=true for port 587 or SMTP_USE_SSL=true for 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
